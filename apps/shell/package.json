{
  "name": "@genoffice/shell",
  "productName": "Nawa",
  "version": "0.11.4",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Abdul-mo-dev/nawa-agent",
  "private": true,
  "description": "Nawa desktop workspace with six GenOffice editors, folder agents, local knowledge and analytics",
  "main": "out/main/index.js",
  "desktopName": "nawa.desktop",
  "scripts": {
    "predev": "node ../../tools/build-embedding-runtime.mjs",
    "dev": "electron-vite dev --watch",
    "build": "node ../../tools/build-embedding-runtime.mjs && electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "pretest": "node ../../tools/build-embedding-runtime.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist:mac": "npm run notices && npm run build && electron-builder --mac",
    "dist:win": "npm run notices && npm run build && electron-builder --win",
    "dist:linux": "npm run notices && npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@genoffice/file-formats": "*",
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/ai-search": "*",
    "@genoffice/cli": "*",
    "@genoffice/docs": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/i18n": "*",
    "@genoffice/pipelines": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/sheets": "*",
    "@genoffice/slides": "*",
    "@genoffice/ui": "*",
    "@genoffice/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.7.6",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "GenOffice",
  "dependencies": {
    "@napi-rs/canvas": "1.0.3",
    "image-size": "2.0.3",
    "utif2": "4.1.0",
    "onnxruntime-node": "1.21.0",
    "onnxruntime-common": "1.21.0"
  }
}
